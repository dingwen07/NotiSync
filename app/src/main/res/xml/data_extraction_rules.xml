<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Database custody depends on device-bound Keystore keys, which cannot be restored.
         Explicit D2D exclusions are required even on OEMs that ignore allowBackup=false. -->
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
